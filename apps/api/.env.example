DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public"
NODE_ENV=development
PORT=3001
# Optional. Local development defaults to 127.0.0.1; production defaults to 0.0.0.0 for managed web services.
# HOST=127.0.0.1
AUTH_JWT_SECRET=<set-strong-auth-secret>
# Required in production/HTTPS; false is only for local development or tests.
AUTH_COOKIE_SECURE=false
AUTH_ALLOWED_ORIGINS=http://localhost:5173
AUTH_COOKIE_SAME_SITE=strict
# Optional when Web and API share a host; use an explicit domain only when required.
# AUTH_COOKIE_DOMAIN=
# JWT lifetime in seconds. Must be a positive integer and no more than 8 hours.
AUTH_SESSION_MAX_AGE_SECONDS=28800
# Local-process login protection: 5 failed attempts per IP in 60 seconds, then 5 minutes blocked.
# This is not shared between API instances; configure shared storage before scaling horizontally.
AUTH_LOGIN_RATE_LIMIT_WINDOW_SECONDS=60
AUTH_LOGIN_RATE_LIMIT_MAX_ATTEMPTS=5
AUTH_LOGIN_RATE_LIMIT_BLOCK_SECONDS=300
